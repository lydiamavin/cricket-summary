# Cricket Comic Strip Generator Environment Variables

# Choose your image generator (openai, grok, piapi, gemini, nano-banana)
GENERATOR=openai

# OpenAI API Key (for openai generator)
OPENAI_API_KEY=your_openai_api_key_here

# Grok API Key (for grok generator)
GROK_API_KEY=your_grok_api_key_here

# PiAPI API Key (for piapi and gemini generators) - Get from https://piapi.ai
PIAPI_API_KEY=your_piapi_api_key_here

# Gemini API Key (for nano-banana generator) - Get from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here